# Datasets crudos bajados (camaras de seguridad, etc): pesados y con licencias
# heterogeneas. Lo que se versiona es el indice del corpus, no los videos.
datasets/

# GATE froth: embeddings pesados de Colab no se versionan (reproducibles con el
# notebook); el parquet de C1 y los reportes md si.
froth_gate/results/*.npz

# ---- Cascade de vigilancia (v-jepa-2/core/cascade) ----
# El corpus crudo es pesado y con licencias heterogeneas: nunca se versiona.
# El indice (metadata.json), el manifest (hashes) y los reportes SI se versionan,
# para que el corpus sea reproducible sin git-lfs/DVC.
v-jepa-2/corpus/raw/
v-jepa-2/results/*.db
v-jepa-2/results/*.db-journal
# Renders del Nivel 2 (stage2_person.visualizar): son salida regenerable y pesan.
v-jepa-2/results/vis_*.jpg
# Videos que la gente sube por POST /jobs/video. Entrada de un cliente, no del repo.
v-jepa-2/uploads/
v-jepa-2/results/vis_*.mp4
# La documentacion se arma desde los resultados y lleva imagenes pesadas.
v-jepa-2/documentation/

